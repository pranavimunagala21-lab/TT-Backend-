# Copy these values into your shell or IntelliJ Run Configuration.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=campussphere
MYSQL_USERNAME=campussphere
MYSQL_PASSWORD=replace-with-your-mysql-password
SERVER_PORT=8084
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JPA_DDL_AUTO=update
DOCUMENT_STORAGE_DIR=./campussphere-data/documents
SPRING_PROFILES_ACTIVE=local
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Generate a private value with at least 32 UTF-8 bytes.
JWT_SECRET=

AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=gpt-4o-mini
